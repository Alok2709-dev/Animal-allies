# Create .env from this file. Never commit .env or any secret to git.

# ── UPI (zero-fee direct donations) ─────────────────────────────────────────
# Your UPI ID — payments go directly to this with zero platform fees.
DONATION_UPI_ID=7398259999@ybl

# ── Razorpay (cards, wallets & UPI via Razorpay checkout) ───────────────────
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret

# ── Gemini AI guide ──────────────────────────────────────────────────────────
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
AI_MAX_REQUESTS_PER_HOUR=20

# ── Email (SMTP) — receipt emails & admin donation alerts ────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASS=replace_with_your_smtp_password
RESCUE_FROM=Animal Allies <alerts@example.com>
RESCUE_ALERT_TO=animalallies11@gmail.com

# ── Twilio SMS alert (optional) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESCUE_ALERT_SMS_TO=+917398259999

PORT=3000
