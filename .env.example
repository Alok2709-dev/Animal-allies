# Create .env from this file. Never publish .env or any secret.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret

# OpenAI AI guide — GPT-5.6 Luna is the inexpensive default.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_CHAT_MODEL=gpt-5.6-luna
AI_MAX_REQUESTS_PER_HOUR=20

# Email alerts: use your mail provider SMTP details (Gmail needs an App Password).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASS=replace_with_your_smtp_password
RESCUE_FROM=Animal Allies <alerts@example.com>
RESCUE_ALERT_TO=animalallies11@gmail.com

# Optional Twilio SMS alert.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESCUE_ALERT_SMS_TO=+917398259999
PORT=3000
